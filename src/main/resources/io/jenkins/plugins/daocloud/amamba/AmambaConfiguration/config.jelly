<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="lib/form">
  <f:section title="DaoCloud Amamba">
    <f:entry title="Platform URL" field="platformUrl"><f:textbox/></f:entry>
    <f:entry title="Platform Secret Text credential ID" field="credentialsId"><f:textbox/></f:entry>
    <f:entry title="Request timeout (seconds)" field="requestTimeoutSeconds"><f:number min="1" max="300"/></f:entry>
    <f:entry title="Workspace environment" field="workspaceEnvironment"><f:property/></f:entry>
  </f:section>
</j:jelly>
